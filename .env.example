# cp .env.example .env   and   source .env    (.env is gitignored)

# The gateway to talk to, and the token for it. The token is the same value you
# would put after "Bearer " in a request — nothing is registered anywhere.
export PRAVACHAN_BASE_URL=https://inference-api.nvidia.com/v1
export PRAVACHAN_API_KEY=your-token-here

# If NVIDIA_API_KEY or OPENAI_API_KEY is already exported, PRAVACHAN_API_KEY is
# optional — the tooling falls back to those, in that order.

# Optional default so you can drop --model
export PRAVACHAN_MODEL=nvidia/baidu/paddleocr-vl

# For the Anthropic API instead:
#   export PRAVACHAN_BASE_URL=https://api.anthropic.com/v1
#   export ANTHROPIC_API_KEY=sk-ant-...
